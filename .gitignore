.overlap_cache/
.fem_cache/
__pycache__/
.claude/

# PC固有・OS固有ファイル（各PCで自動生成されるため同期対象外）
frs2015_gui_state.json
frs2015_gui_state_knee.json
frs2015_gui_state_knee_sim.json
.DS_Store
.vscode/
*.test_cache/

# cache/ 配下: 事前計算キャッシュ(pkl)は大容量のため git 共有しない
# （別PCへは Box/USB 等で cache/overlap/ をコピーする。内容ハッシュ方式なのでOS非依存で当たる）。
# シーン共有ファイル knee_scene.json（小さい・パス非依存）だけ git で共有する。
cache/*
!cache/knee_scene.json
*.pkl